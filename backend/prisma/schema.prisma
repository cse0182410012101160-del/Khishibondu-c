generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  farmer
  buyer
  ngo
  agent
  admin
}

enum CropStatus {
  Listed
  Negotiating
  Sold
  Cancelled
}

enum BidStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum OrderStatus {
  Listed
  Negotiating
  Confirmed
  Delivered
  Paid
  Disputed
  Cancelled
}

enum EscrowStatus {
  CREATED
  LOCKED
  FUNDED
  IN_TRANSIT
  DELIVERED
  RELEASED
  REFUNDED
  DISPUTED
}

model User {
  id                   String       @id @default(uuid())
  phone                String       @unique
  role                 UserRole
  name                 String
  district             String?
  verified             Boolean      @default(false)
  createdAt            DateTime     @default(now())
  crops                CropLot[]
  bids                 Bid[]
  buyerOrders          Order[]      @relation("buyerOrders")
  farmerOrders         Order[]      @relation("farmerOrders")
  creditEvents         CreditEvent[]
  auditLogs            AuditLog[]
}

model CropLot {
  id                String      @id @default(uuid())
  farmerId          String
  agentId           String?
  cropType          String
  title             String
  quantity          Decimal     @db.Decimal(12, 2)
  unit              String
  askPricePerUnit   Decimal     @db.Decimal(12, 2)
  district          String
  harvestDate       DateTime?
  qualityGrade      String?
  status            CropStatus  @default(Listed)
  qrCode            String?     @unique
  createdAt         DateTime    @default(now())
  farmer            User        @relation(fields: [farmerId], references: [id])
  bids              Bid[]
  orders            Order[]
  traceEvents       TraceEvent[]
  sprayRecords      SprayRecord[]
}

model Bid {
  id                  String     @id @default(uuid())
  lotId               String
  buyerId             String
  pricePerUnit        Decimal    @db.Decimal(12, 2)
  quantity            Decimal    @db.Decimal(12, 2)
  status              BidStatus  @default(pending)
  note                String?
  createdAt           DateTime   @default(now())
  lot                 CropLot    @relation(fields: [lotId], references: [id])
  buyer               User       @relation(fields: [buyerId], references: [id])
  orders              Order[]
}

model Order {
  id             String        @id @default(uuid())
  lotId          String
  bidId          String?       @unique
  farmerId       String
  buyerId        String
  totalAmount    Decimal       @db.Decimal(14, 2)
  status         OrderStatus   @default(Listed)
  createdAt      DateTime      @default(now())
  lot            CropLot       @relation(fields: [lotId], references: [id])
  bid            Bid?          @relation(fields: [bidId], references: [id])
  farmer         User          @relation("farmerOrders", fields: [farmerId], references: [id])
  buyer          User          @relation("buyerOrders", fields: [buyerId], references: [id])
  escrow         Escrow?
  ledgerEntries  LedgerEntry[]
  disputes       Dispute[]
}

model Escrow {
  id             String        @id @default(uuid())
  orderId        String        @unique
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("BDT")
  paymentRail    String
  status         EscrowStatus  @default(LOCKED)
  providerRef    String?
  idempotencyKey String        @unique
  holdStartedAt  DateTime      @default(now())
  releasedAt     DateTime?
  order          Order         @relation(fields: [orderId], references: [id])
  ledgerEntries  LedgerEntry[]
}

model LedgerEntry {
  id             String       @id @default(uuid())
  orderId        String
  escrowId       String?
  type           String
  amount         Decimal      @db.Decimal(14, 2)
  status         String
  providerRef    String?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  order         Order        @relation(fields: [orderId], references: [id])
  escrow         Escrow?      @relation(fields: [escrowId], references: [id])
}

model CreditEvent {
  id          String   @id @default(uuid())
  farmerId    String
  score       Int
  tier        String
  factors     Json
  computedAt  DateTime @default(now())
  farmer      User     @relation(fields: [farmerId], references: [id])
}

model Loan {
  id            String   @id @default(uuid())
  farmerId      String
  mfiId         String
  amount        Decimal  @db.Decimal(14, 2)
  tenureMonths  Int
  rate          Decimal  @db.Decimal(5, 2)
  status        String
  createdAt     DateTime @default(now())
}

model Dispute {
  id        String   @id @default(uuid())
  orderId   String
  raisedBy  String
  reason    String
  evidence  Json?
  status    String
  resolution String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model TraceEvent {
  id        String   @id @default(uuid())
  lotId     String
  type      String
  location  String?
  timestamp DateTime @default(now())
  lot       CropLot  @relation(fields: [lotId], references: [id])
}

model SprayRecord {
  id              String   @id @default(uuid())
  lotId           String
  chemical        String
  date            DateTime
  preHarvestDays  Int
  lot             CropLot  @relation(fields: [lotId], references: [id])
}

model GroupLot {
  id            String            @id @default(uuid())
  groupId       String
  leaderId      String
  status        String            @default("OPEN")
  members       GroupLotMember[]
  walletRecords WalletRecord[]
  createdAt     DateTime          @default(now())
}

model GroupLotMember {
  id         String   @id @default(uuid())
  groupLotId String
  memberId   String
  kg         Decimal  @db.Decimal(12, 3)
  groupLot   GroupLot @relation(fields: [groupLotId], references: [id])
}

model WalletRecord {
  id         String    @id @default(uuid())
  groupLotId String?
  memberId   String
  amountPaisa Int
  createdAt  DateTime  @default(now())
  groupLot   GroupLot? @relation(fields: [groupLotId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  before    Json?
  after     Json?
  at        DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
}
